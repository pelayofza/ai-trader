from ai_trader.data.market_data import MarketDataService

svc = MarketDataService()

markets = svc.search_prediction_markets("bitcoin", limit=5)
print(len(markets))
print(markets[0].question)
print(markets[0].yes_token)
print(markets[0].no_token)

market = svc.get_prediction_market(markets[0].slug)
print(market.slug, market.enable_order_book)

if market.yes_token:
    book = svc.get_prediction_orderbook(market.yes_token.token_id)
    print(book)
    mid = svc.get_prediction_midpoint(market.yes_token.token_id)
    print(mid)