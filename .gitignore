# Entorno virtual
.venv/
venv/

# Variables de entorno (secretos)
.env

# Cachés Python
__pycache__/
*.pyc
.cache/

# Herramientas
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.json
htmlcov/

# Logs
*.log

# Estado de ejecución y datos locales (mutables, no son fuente)
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.json
# copias de seguridad rotatorias de runtime_state.json
data/*.json.[0-9]
data/archive/
data/synthetic/
data/signals_raw/
# Diario de ciclos del paper trading en vivo (data/live/cycles*.jsonl). NO se versiona:
# es un archivo append-only que crece cada 15 minutos en la máquina que opera, y sería
# un conflicto de merge permanente. Pero SÍ es un activo del proyecto y no se puede
# regenerar -- ver "Operación continua" en el README para la copia de seguridad.
data/live/
# Puntos de guardado de los barridos largos (data/*/progress_*.jsonl). Es estado TRANSITORIO:
# el estudio lo borra al publicar sus unidades, y mientras existe solo sirve para reanudar en
# esta máquina. Lo que se versiona es el fichero de unidades, que es el resultado.
data/*/progress_*.jsonl
data/*/progress_*.jsonl.stale

# VS Code
.vscode/
