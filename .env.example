# Copia este archivo a .env y rellena valores.

# --- Telegram (canal de alertas y escalado de decisiones) ---
# Token del bot, obtenido de @BotFather.
TELEGRAM_BOT_TOKEN=
# Lista blanca de chat ids autorizados, separados por comas.
# Sin esto, cualquiera que encuentre el bot puede operarlo.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Alpaca (datos de renta variable) ---
# Solo hacen falta si el universo incluye simbolos de stock.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
